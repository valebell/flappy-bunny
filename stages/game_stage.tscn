[sub_resource type="GDScript" id=1]
resource_name = "BtnInstructions"
script/source = "extends TextureButton

const bird_texture = preload(\"res://sprites/instructions-bird.png\")
const bunny_texture = preload(\"res://sprites/instructions.png\")

func _ready():
	grab_focus()
	connect(\"pressed\", self, \"_on_pressed\")
	if Game.selected_perso == 1:
		self.texture_normal = bird_texture
	else:
		self.texture_normal = bunny_texture

func _on_pressed() -> void:
	var bird = Utils.get_main_node().get_node(\"Bird\")
	if bird:
		bird.set_state(Bird.STATE_FLAP)
		get_node(\"AnimationPlayer\").play(\"hide\")
		hide()
"

