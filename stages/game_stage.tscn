[sub_resource type="GDScript" id="10"]
script/source = "extends Control

func _physics_process(_delta: float) -> void:
	if Game.has_bird():
		self.get_node(\"BirdSprite/AnimationPlayer\").play(\"highlight\")
	else:
		self.get_node(\"BirdSprite/AnimationPlayer\").play(\"inactive\")

func _on_Container2_gui_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"jump\") && Game.has_bird():
		Game.set_selected_character(1)
		StageManager.change_stage(\"res://stages/game_stage.tscn\")
"

