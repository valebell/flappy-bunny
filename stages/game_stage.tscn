[sub_resource type="GDScript" id="3"]
script/source = "extends HBoxContainer

const sprite_numbers = [
	preload(\"res://sprites/0_big.png\"),
	preload(\"res://sprites/1_big.png\"),
	preload(\"res://sprites/2_big.png\"),
	preload(\"res://sprites/3_big.png\"),
	preload(\"res://sprites/4_big.png\"),
	preload(\"res://sprites/5_big.png\"),
	preload(\"res://sprites/6_big.png\"),
	preload(\"res://sprites/7_big.png\"),
	preload(\"res://sprites/8_big.png\"),
	preload(\"res://sprites/9_big.png\")
]

func _ready() -> void:
	Game.connect(\"score_current_updated\", Callable(self, \"_on_score_current_updated\"))
	_set_score(Game.score_current)
	var bird = Utils.get_main_node().get_node(\"Bird\")
	if bird:
		bird.connect(\"state_changed\", Callable(self, \"_on_bird_state_changed\"))
	pass

func _on_score_current_updated():
	for child in get_children():
		child.queue_free()
	_set_score(Game.score_current)
	pass

func _on_bird_state_changed(bird: Bird):
	if bird.get_state() == Bird.STATE_GROUNDED:
		hide()
	else:
		show()

func _set_score(score: int):
	var score_str = str(score)
	var length = score_str.length()
	var index = 0
	while index < length:
		var digit = score_str[index].to_int()
		var textureFrame = TextureRect.new()
		textureFrame.texture = sprite_numbers[digit]
		self.add_child(textureFrame)
		index += 1
	pass
"

[sub_resource type="GDScript" id="4"]
script/source = "extends Control

func _ready() -> void:
	hide()
	var bird: Bird = Utils.get_main_node().get_node(\"Bird\")
	if bird:
		bird.connect(\"state_changed\", Callable(self, \"_on_bird_state_changed\"))
	pass

func _on_bird_state_changed(bird: Bird):
	if bird.get_state() == Bird.STATE_GROUNDED:
		get_node(\"AnimationPlayer\").play(\"show\")
	pass
"

[sub_resource type="GDScript" id="5"]
script/source = "extends HBoxContainer

const sprite_numbers = [
	preload(\"res://sprites/0_small.png\"),
	preload(\"res://sprites/1_small.png\"),
	preload(\"res://sprites/2_small.png\"),
	preload(\"res://sprites/3_small.png\"),
	preload(\"res://sprites/4_small.png\"),
	preload(\"res://sprites/5_small.png\"),
	preload(\"res://sprites/6_small.png\"),
	preload(\"res://sprites/7_small.png\"),
	preload(\"res://sprites/8_small.png\"),
	preload(\"res://sprites/9_small.png\")
]

signal counting_done

func _ready() -> void:
	var anim = Utils.get_main_node().get_node(\"hud/Container/AnimationPlayer\")
	await anim.animation_finished
	count_to_score()
	emit_signal(\"counting_done\")
	pass

func count_to_score():
	var lerp_time = 0
	var lerp_duration = 0.3
	
	while lerp_time < lerp_duration:
		lerp_time += get_process_delta_time()
		lerp_time = min(lerp_time, lerp_duration)
		
		var percent = lerp_time / lerp_duration
		_set_score(int(lerp(0, Game.score_current, percent)))
		await get_tree().process_frame
	Game.score_best = Game.score_current
	

func _set_score(score: int):
	for child in get_children():
		child.queue_free()
	var score_str = str(score)
	var length = score_str.length()
	var index = 0
	while index < length:
		var digit = score_str[index].to_int()
		var textureFrame = TextureRect.new()
		textureFrame.texture = sprite_numbers[digit]
		self.add_child(textureFrame)
		index += 1
	pass
"

[sub_resource type="GDScript" id="15"]
script/source = "extends HBoxContainer

const sprite_numbers = [
	preload(\"res://sprites/0_small.png\"),
	preload(\"res://sprites/1_small.png\"),
	preload(\"res://sprites/2_small.png\"),
	preload(\"res://sprites/3_small.png\"),
	preload(\"res://sprites/4_small.png\"),
	preload(\"res://sprites/5_small.png\"),
	preload(\"res://sprites/6_small.png\"),
	preload(\"res://sprites/7_small.png\"),
	preload(\"res://sprites/8_small.png\"),
	preload(\"res://sprites/9_small.png\")
]

func _ready() -> void:
	var end_score = Utils.get_main_node().find_child(\"end_score_nb\")
	if end_score:
		end_score.connect(\"counting_done\", Callable(self, \"_on_score_best_updated\"))
	_set_score(Game.score_best)

func _on_score_best_updated():
	for child in get_children():
		child.queue_free()
	_set_score(Game.score_best)
	pass

func _set_score(score: int):
	var score_str = str(score)
	var max_score_length = str(Game.MAX_SCORE).length()
	while score_str.length() < max_score_length:
		score_str = \"0\" + score_str
	var length = score_str.length()
	var index = 0
	while index < length:
		var digit = score_str[index].to_int()
		var textureFrame = TextureRect.new()
		textureFrame.texture = sprite_numbers[digit]
		self.add_child(textureFrame)
		index += 1
	pass
"

